APP_NAME="Internship Application Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=internship_monitor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@uls-test.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:*,127.0.0.1:*
SANCTUM_TOKEN_EXPIRATION_MINUTES=60

# Week 15 - Module 15 / SA9 strict CORS allowlist (no wildcards in production).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000

# ---------------------------------------------------------------------------
# Week 13 — Module 13 / SA7 automation (milestone reminders & scheduled sweeps)
# ---------------------------------------------------------------------------
AUTOMATION_DISPATCHER_MODE=log
AUTOMATION_DISPATCHER_URL=
AUTOMATION_DISPATCHER_TOKEN=
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_RETRY_BASE_SECONDS=10
AUTOMATION_RETRY_JITTER_SECONDS=3
AUTOMATION_TIMEOUT_SECONDS=5
AUTOMATION_ALLOW_FAULT_INJECTION=false
AUTOMATION_FALLBACK_RECIPIENT="coord.demo@uls-test.edu.ph"
AUTOMATION_INCOMPLETE_AFTER_HOURS=48
AUTOMATION_STALLED_AFTER_DAYS=5
AUTOMATION_SWEEP_DISPATCH_LIMIT=50

# ---------------------------------------------------------------------------
# Week 14 - Module 14 / SA8 cryptographic integration
# ---------------------------------------------------------------------------
# Keys are base64-encoded 256-bit values and belong in .env ONLY.
# Generate a non-production set with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
CRYPTO_ACTIVE_KID=v2
CRYPTO_KEY_V1_ENC=
CRYPTO_KEY_V1_SIG=
CRYPTO_KEY_V2_ENC=
CRYPTO_KEY_V2_SIG=
CRYPTO_CLOCK_SKEW_SECONDS=300
CRYPTO_NONCE_TTL_SECONDS=900
CRYPTO_ALLOW_TAMPER_SIMULATION=false

# ---------------------------------------------------------------------------
# Week 15 - Module 15 / SA9 security hardening
# ---------------------------------------------------------------------------
SECURITY_MAX_PAYLOAD_KB=64
SECURITY_SANITIZE_INPUT=true
SECURITY_AUTH_LOGIN_PER_MIN=5
SECURITY_API_STANDARD_PER_MIN=60
SECURITY_WEBHOOK_PER_MIN=30

VITE_APP_NAME="${APP_NAME}"